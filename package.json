{
  "name": "@autobot/omp-session-coordinator-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Native OMP extension for an authenticated per-PC session coordinator bus.",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-AutoBot/omp-session-coordinatior-extension.git"
  },
  "type": "module",
  "omp": {
    "extensions": ["./src/extension/index.ts"]
  },
  "exports": {
    ".": "./src/extension/index.ts",
    "./session-bus-client": "./src/extension/session-bus-client.ts",
    "./native-input-receipt": "./src/extension/native-input-receipt.ts",
    "./native-voice": "./src/extension/native-voice.ts",
    "./collab-registry": "./src/extension/collab-registry.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/*.test.ts",
    "smoke": "bun --no-env-file tests/consumer-smoke.ts"
  },
  "dependencies": { "zod": "^4.1.0" },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.3.0",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
